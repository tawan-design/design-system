{
  "name": "@tawan-design/ui",
  "version": "0.2.0",
  "description": "Design system components (React + TypeScript + Radix + Tailwind), owned by the Design team.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./catalog.json": "./catalog.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./catalog.json": "./catalog.json"
    }
  },
  "files": [
    "dist",
    "catalog.json"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles.css -o dist/styles.css --minify && pnpm catalog",
    "catalog": "node scripts/generate-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@tawan-design/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.3.0",
    "@storybook/react": "^8.6.14",
    "@tailwindcss/cli": "^4.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3"
  }
}
